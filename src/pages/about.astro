---
import BaseHead from "@/components/layout/BaseHead.astro";
import ParticleAvatar from "@/components/about/ParticleAvatar.astro";
import StaggeredMenu from "@/components/homepage/StaggeredMenu.astro";
import "@/styles/tailwind.css";

const menuItems = [
  { label: "Home", link: "/", ariaLabel: "Go to Home" },
  { label: "Posts", link: "/blogs", ariaLabel: "Go to Posts" },
  { label: "Labs", link: "/labs", ariaLabel: "Go to Labs" },
  { label: "Resumes", link: "/resumes", ariaLabel: "Go to Resumes" },
];
const socialItems = [
  { label: "GitHub", link: "https://github.com" },
  { label: "Email", link: "mailto:hi@feichuan.dev" },
];
const posts = [
  { title: "A note about building interfaces", description: "Details, constraints, and the work between states." },
  { title: "Working with AI agents", description: "Notes from designing and building agent products." },
  { title: "Experiments in motion", description: "Small studies in interaction, graphics, and feel." },
];
const experience = [
  { date: "2024 - Current", company: "Company One", role: "Senior Frontend Engineer", description: "Led a product area from interaction model and interface system through implementation and release. Worked closely with design and engineering to make complex workflows feel clear and dependable." },
  { date: "2022 - 2024", company: "Company Two", role: "Frontend Engineer", description: "Built user-facing workflows and reusable foundations for a growing product team. Improved consistency across the interface while keeping delivery practical and maintainable." },
];
const stack = [
  { label: "Frontend", items: "TypeScript / React / Astro / Vue / Tailwind CSS" },
  { label: "Interaction", items: "Motion / GSAP / Three.js / WebGL" },
  { label: "Backend", items: "Node.js / Cloudflare / PostgreSQL / Docker" },
  { label: "Workflow", items: "Figma / GitHub / Claude / Codex / Obsidian" },
];
const projects = [
  { title: "Project Alpha", description: "A product interface built for a complex workflow." },
  { title: "Project Beta", description: "A design system shared across several product surfaces." },
  { title: "Project Gamma", description: "A technical experiment turned into a useful tool." },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="About" description="About and selected work." ogType="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Lora:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <StaggeredMenu
      position="right"
      items={menuItems}
      socialItems={socialItems}
      colors={["#DA702C", "#4385BE"]}
      accentColor="#DA702C"
      menuButtonColor="#111111"
      openMenuButtonColor="#111111"
      logoUrl="/feichuan-logo.svg"
    />

    <main>
      <div class="paper-container">
        <div class="about-heading">
          <h1>Hi, I'm Your Name <span>👋🏻</span></h1>
          <ParticleAvatar />
        </div>
        <div class="paper-flow">
          <section class="intro-section">
            <article>
              <p>I am a design-minded frontend engineer focused on building clear, responsive, and carefully crafted digital products. I enjoy the space where engineering, interaction, and emerging technology meet.</p>
              <p>My work moves between product interfaces, design systems, creative coding, and AI experiences. I care about how software looks, feels, behaves, and recovers when things do not go as planned.</p>
              <p>This page is a concise introduction and an online resume. You can browse the work below or <a href="mailto:hi@feichuan.dev">get in touch</a>.</p>
            </article>
          </section>

          <section class="paper-section agent-section" aria-labelledby="agent-title">
            <div class="section-heading"><h2 id="agent-title">Personal agent</h2><span>Preview</span></div>
            <div id="siri-stage" class="orb-stage">
              <div id="siri-surface" class="orb-surface">
                <div id="siri-backdrop" class="siri-backdrop" aria-hidden="true"></div>
                <canvas id="siri-canvas" class="orb-canvas" aria-hidden="true"></canvas>
                <div id="siri-hit-target" class="siri-hit-target" tabindex="0" role="button" aria-label="Glass voice orb. Click to ask, hold to speak, or drag to reposition."></div>
                <div id="siri-dialog" class="siri-dialog" aria-hidden="true">
                  <form id="siri-ask" class="siri-ask" autocomplete="off">
                    <input id="siri-input" type="text" placeholder="Ask me anything" maxlength="160" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="send" aria-label="Ask the personal agent" />
                    <span class="siri-mic" aria-hidden="true">
                      <svg viewBox="0 0 24 24" focusable="false"><path d="M12 14.5a3.5 3.5 0 0 0 3.5-3.5V6a3.5 3.5 0 0 0-7 0v5a3.5 3.5 0 0 0 3.5 3.5Z"></path><path d="M5 10.8a7 7 0 0 0 14 0M12 18v4M8.5 22h7"></path></svg>
                    </span>
                  </form>
                  <p id="siri-answer" class="siri-answer" aria-live="polite"></p>
                </div>
                <button id="siri-control" class="siri-control" type="button">Hold to speak</button>
              </div>
              <p id="siri-status" class="sr-only" aria-live="polite">Idle. Drag the orb to reposition it.</p>
            </div>
          </section>

          <section class="paper-section" aria-labelledby="posts-title">
            <div class="section-heading"><h2 id="posts-title">Latest posts</h2><a href="/blogs">See all posts</a></div>
            <ul class="arrow-list">{posts.map((post) => <li><a class="arrow-card" href="/blogs"><span><strong>{post.title}</strong><small>{post.description}</small></span><b aria-hidden="true">›</b></a></li>)}</ul>
          </section>

          <section class="paper-section" aria-labelledby="experience-title">
            <div class="section-heading"><h2 id="experience-title">Work Experience</h2><a href="/resumes">See resume</a></div>
            <ul class="experience-list">{experience.map((item) => <li><div class="entry-date">{item.date}</div><div class="entry-company">{item.company}</div><div class="entry-role">{item.role}</div><article><p>{item.description}</p></article></li>)}</ul>
          </section>

          <section class="paper-section" aria-labelledby="stack-title">
            <div class="section-heading"><h2 id="stack-title">Stack</h2></div>
            <dl class="stack-list">{stack.map((group) => <div><dt>{group.label}</dt><dd>{group.items}</dd></div>)}</dl>
          </section>

          <section class="paper-section" aria-labelledby="projects-title">
            <div class="section-heading"><h2 id="projects-title">Recent projects</h2><a href="/labs">See all projects</a></div>
            <ul class="arrow-list">{projects.map((project) => <li><a class="arrow-card" href="/labs"><span><strong>{project.title}</strong><small>{project.description}</small></span><b aria-hidden="true">›</b></a></li>)}</ul>
          </section>

          <section class="connect-section" aria-labelledby="connect-title">
            <h2 id="connect-title">Let's Connect</h2>
            <article><p>If you want to get in touch about something or just say hi, reach out on social media or send me an email.</p></article>
            <ul class="connect-links"><li><a href="https://github.com">github</a><span>/</span></li><li><a href="#">linkedin</a><span>/</span></li><li><a href="#">twitter</a><span>/</span></li><li><a href="mailto:hi@feichuan.dev">hi@feichuan.dev</a></li></ul>
          </section>
        </div>
      </div>
    </main>
    <script is:inline src="/vendor/glass-voice-orb-study/src/params.js"></script>
    <script is:inline src="/vendor/glass-voice-orb-study/src/shaders.js"></script>
    <script is:inline src="/vendor/glass-voice-orb-study/src/pipeline.js"></script>
    <script is:inline src="/vendor/glass-voice-orb-study/src/uniforms.js"></script>
    <script is:inline src="/vendor/glass-voice-orb-study/src/state.js"></script>
    <script is:inline src="/vendor/glass-voice-orb-study/src/audio.js"></script>
    <script is:inline src="/vendor/glass-voice-orb-study/src/renderer.js"></script>
    <script is:inline src="/vendor/glass-voice-orb-study/src/embed-main.js"></script>
  </body>
</html>

<style is:global>
  :root { --paper-bg:#f5f4ed; --paper-text:rgba(0,0,0,.5); --paper-strong:#000; --paper-line:rgba(0,0,0,.15); }
  html { overflow-y:scroll;color-scheme:light;background:var(--paper-bg); }
  body { min-height:100%;margin:0;color:var(--paper-text);background:var(--paper-bg);font-family:"Inter",ui-sans-serif,system-ui,sans-serif;-webkit-font-smoothing:antialiased; }
  * { box-sizing:border-box; } a { color:inherit;text-decoration:underline;text-decoration-color:rgba(0,0,0,.15);text-underline-offset:2px;transition:color .3s ease,text-decoration-color .3s ease; } a:hover { color:var(--paper-strong);text-decoration-color:rgba(0,0,0,.25); }
  main { min-height:100vh;padding:128px 0; }.paper-container { width:100%;max-width:640px;margin-inline:auto;padding-inline:20px; }.about-heading { --avatar-size:128px;display:flex;min-height:128px;align-items:center;justify-content:space-between;gap:24px; }.about-heading>h1 { margin:0;color:var(--paper-strong);font-size:16px;font-weight:600;line-height:24px;letter-spacing:0; }.about-heading>h1 span { font-size:20px; }.paper-flow { display:flex;flex-direction:column;gap:64px;margin-top:20px; }
  article { max-width:100%;font-family:"Lora",ui-serif,Georgia,serif;font-size:16px;line-height:28px; } article p { margin:0; }.intro-section article { display:flex;flex-direction:column;gap:16px; }
  .paper-section { display:flex;flex-direction:column;gap:24px; }.section-heading { display:flex;min-height:24px;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px; }.section-heading h2,.connect-section h2 { margin:0;color:var(--paper-strong);font-size:16px;font-weight:600;line-height:24px; }.section-heading>a,.section-heading>span { font-size:16px;line-height:24px; }
  .sr-only { position:absolute;width:1px;height:1px;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap; }
  .orb-stage { position:relative;width:100%;height:300px;overflow:visible;background:transparent; }
  .orb-surface { --orb-x:0px;--orb-y:0px;--dialog-inline:320px;--dialog-edge-gap:28px;--dialog-control-gap:38px;--dialog-reply-pad:28px;--caret-glow-size:90px;--caret-glow-alpha:1;position:absolute;inset:0;z-index:20;transform:translate3d(var(--orb-x),var(--orb-y),0);pointer-events:none;will-change:transform; }
  .siri-backdrop { position:absolute;z-index:0;overflow:hidden;pointer-events:none;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.42);-webkit-backdrop-filter:blur(10px) saturate(1.25) brightness(1.04);backdrop-filter:blur(10px) saturate(1.25) brightness(1.04);box-shadow:inset 0 1px 1px rgba(255,255,255,.72),inset 0 -1px 1px rgba(0,0,0,.12),0 10px 32px rgba(0,0,0,.08);will-change:left,top,width,height,border-radius; }
  .siri-backdrop::before { content:"";position:absolute;inset:0;background:linear-gradient(145deg,rgba(255,255,255,.2),transparent 38%,rgba(255,255,255,.06) 68%,rgba(0,0,0,.08));pointer-events:none; }
  .orb-canvas { position:absolute;inset:0;z-index:1;display:block;width:100%;height:100%;background:transparent;pointer-events:none; }
  .siri-hit-target { position:absolute;z-index:2;background:transparent;cursor:grab;pointer-events:auto;touch-action:none; }
  .orb-surface[data-dragging="true"] .siri-hit-target { cursor:grabbing; }
  .siri-dialog { position:absolute;left:50%;top:50%;z-index:3;display:grid;width:var(--dialog-inline);min-height:92px;place-items:center;padding:0 10px;transform:translate(-50%,-50%);pointer-events:none;animation:dialog-opacity-breathe 2.8s ease-in-out infinite; }
  .siri-ask,.siri-answer { grid-area:1/1;width:100%;margin:0;color:#fff;font:400 16px/1.45 "Inter",ui-sans-serif,system-ui,sans-serif;letter-spacing:0;opacity:0;pointer-events:none;text-shadow:0 1px 7px rgba(0,0,0,.42);transition:opacity .28s ease; }
  .siri-ask { position:relative;padding:0 var(--dialog-control-gap); }
  .siri-ask::before,.siri-ask::after { content:"";position:absolute;left:var(--dialog-edge-gap);top:50%;opacity:0;pointer-events:none;animation:caret-glow 1.45s ease-in-out infinite; }
  .siri-ask::before { width:calc(var(--caret-glow-size)*.58);height:calc(var(--caret-glow-size)*.84);border-radius:999px;transform:translate(-50%,-50%);background:radial-gradient(ellipse at center,rgba(255,255,255,calc(var(--caret-glow-alpha)*.86)) 0%,rgba(255,238,162,calc(var(--caret-glow-alpha)*.72)) 18%,rgba(93,230,255,calc(var(--caret-glow-alpha)*.62)) 42%,rgba(118,94,255,calc(var(--caret-glow-alpha)*.38)) 64%,rgba(93,230,255,0) 100%);filter:blur(12px);mix-blend-mode:screen; }
  .siri-ask::after { width:4px;height:42px;border-radius:999px;transform:translate(-50%,-50%);background:linear-gradient(180deg,#fff6a8 0%,#fff 38%,#74f3ff 62%,#665cff 100%);box-shadow:0 0 10px rgba(255,236,156,.95),0 0 20px rgba(93,230,255,.9),0 0 34px rgba(118,94,255,.78),0 0 var(--caret-glow-size) rgba(93,230,255,var(--caret-glow-alpha)); }
  .siri-dialog[data-mode="ask"],.siri-dialog[data-mode="reply"] { pointer-events:auto; }
  .siri-dialog[data-mode="ask"] .siri-ask { opacity:1;pointer-events:auto;transition-delay:.18s; }
  .siri-dialog[data-mode="ask"] .siri-ask::before,.siri-dialog[data-mode="ask"] .siri-ask::after { opacity:1; }
  .siri-dialog[data-mode="reply"] .siri-answer { opacity:.9;pointer-events:auto;transition-delay:.18s; }
  .siri-ask input { width:100%;margin:0;padding:0;border:0;outline:0;background:transparent;color:inherit;font:inherit;text-align:left;caret-color:transparent; }
  .siri-ask input::placeholder { color:rgba(255,255,255,.44); }
  .siri-mic { position:absolute;right:var(--dialog-edge-gap);top:50%;width:30px;height:30px;transform:translateY(-50%);color:rgba(255,255,255,.58); }
  .siri-mic svg { width:100%;height:100%;fill:none;stroke:currentColor;stroke-width:1.85;stroke-linecap:round;stroke-linejoin:round; }
  .siri-answer { max-height:86px;overflow:hidden;padding:0 var(--dialog-reply-pad);white-space:pre-wrap; }
  .siri-control { position:absolute;left:50%;bottom:10px;z-index:3;min-width:136px;max-width:calc(100% - 32px);margin:0;padding:8px 14px;transform:translateX(-50%);border:1px solid rgba(0,0,0,.14);border-radius:999px;background:rgba(255,255,255,.42);backdrop-filter:blur(14px);color:rgba(0,0,0,.62);font:500 14px/1 "Inter",ui-sans-serif,system-ui,sans-serif;letter-spacing:0;white-space:nowrap;cursor:pointer;pointer-events:auto; }
  .siri-control[data-active="true"] { color:rgba(0,0,0,.84); }
  .siri-control:focus-visible,.siri-hit-target:focus-visible { outline:2px solid #4385be;outline-offset:4px; }
  @keyframes caret-glow { 0%,100%{opacity:.45;transform:translate(-50%,-50%) scaleY(.92)}50%{opacity:1;transform:translate(-50%,-50%) scaleY(1.08)} }
  @keyframes dialog-opacity-breathe { 0%,100%{opacity:.9}50%{opacity:1} }
  .arrow-list,.experience-list,.connect-links { display:flex;margin:0;padding:0;list-style:none; }.arrow-list { flex-direction:column;gap:16px; }.arrow-card { position:relative;display:flex;width:100%;height:70px;align-items:center;padding:12px 40px 12px 16px;overflow:hidden;border:1px solid var(--paper-line);border-radius:8px;text-decoration:none; }.arrow-card>span { display:flex;min-width:0;flex:1;flex-direction:column;overflow:hidden; }.arrow-card strong { overflow:hidden;color:var(--paper-strong);font-size:16px;font-weight:600;line-height:24px;text-overflow:ellipsis;white-space:nowrap; }.arrow-card small { overflow:hidden;font-size:14px;line-height:20px;text-overflow:ellipsis;white-space:nowrap; }.arrow-card b { position:absolute;right:16px;color:var(--paper-text);font-size:28px;font-weight:400;transition:transform .3s ease; }.arrow-card:hover b { transform:translateX(3px); }
  .experience-list { flex-direction:column;gap:16px; }.experience-list li { min-height:216px; }.entry-date,.entry-role { font-size:14px;line-height:20px; }.entry-company { color:var(--paper-strong);font-size:16px;font-weight:600;line-height:24px; }.experience-list article { margin-top:16px; }
  .stack-list { margin:0; }.stack-list>div { display:grid;grid-template-columns:112px minmax(0,1fr);gap:12px;padding:10px 0;border-bottom:1px solid rgba(0,0,0,.08); }.stack-list>div:first-child { padding-top:0; }.stack-list>div:last-child { padding-bottom:0;border-bottom:0; }.stack-list dt { color:var(--paper-strong);font-size:14px;font-weight:600;line-height:22px; }.stack-list dd { margin:0;font-size:14px;line-height:22px; }
  .connect-section { display:flex;flex-direction:column;gap:16px; }.connect-links { flex-wrap:wrap;gap:8px; }.connect-links li { display:flex;gap:8px;white-space:nowrap; }
  a:focus-visible { outline:2px solid #4385be;outline-offset:3px; }
  @media(max-width:640px){main{padding:112px 0 96px}.about-heading{--avatar-size:104px;min-height:104px}.paper-flow{gap:56px}.stack-list>div{grid-template-columns:92px minmax(0,1fr)}.orb-stage{height:280px}.orb-surface{--dialog-edge-gap:24px;--dialog-control-gap:34px}}
  @media(prefers-reduced-motion:reduce){*,*::before,*::after{transition-duration:.01ms!important}}
</style>
