---
export const prerender = false;

import Base from "../../layouts/Base.astro";
import BlogList from "@/components/blog/BlogList.astro";
---

<Base title="Posts">
  <main class="blogs-page min-h-screen pt-32 pb-20">
    <section class="blogs-hero px-6 py-6 text-white mix-blend-difference">
      <h2 class="blogs-title">文章列表</h2>
    </section>

    <section class="content w-full p-4">
      <div class="left"></div>
      <div class="center">
        <BlogList />
      </div>
      <div class="right"></div>
    </section>
  </main>
</Base>

<style>
  .blogs-hero {
    display: flex;
    justify-content: center;
  }

  .blogs-title {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    line-height: 1.1;
    font-family: serif;
    text-align: center;
  }

  .content {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    scrollbar-width: none;
  }

  .content > div {
    min-width: 0;
  }

  @media (max-width: 768px) {
    .content {
      display: block;
    }

    .content > .left,
    .content > .right {
      display: none;
    }
  }
</style>
