---
import BaseHead from "@/components/BaseHead.astro";
import InfiniteMenu from "@/components/InfiniteMenu";

import "@/styles/global.css";

const menuItems = [
  {
    image: "https://img.feichuans.com/file/1772810468996_20260306232045804.png",
    link: "https://img.feichuans.com/file/1772810468996_20260306232045804.png",
    title: "Resume 01",
    description: "第一份参考简历",
  },
  {
    image: "https://img.feichuans.com/file/1773113689908_20260310113425583.png",
    link: "https://img.feichuans.com/file/1773113689908_20260310113425583.png",
    title: "Resume 02",
    description: "第二份参考简历",
  },
];
---

<!doctype html>
<html lang="zh-cn">
  <head>
    <BaseHead
      title="Resumes"
      description="Fullscreen resume reference menu."
      ogType="website"
    />
  </head>
  <body class="resumes-body">
    <main class="resumes-menu-shell">
      <InfiniteMenu client:load items={menuItems} scale={1.32} />
    </main>
  </body>
</html>

<style>
  :global(html),
  :global(body) {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .resumes-body {
    margin: 0;
    background:
      radial-gradient(
        circle at 50% 18%,
        rgba(255, 255, 255, 0.92),
        transparent 28rem
      ),
      linear-gradient(
        180deg,
        rgba(244, 244, 242, 0.98),
        rgba(226, 229, 234, 0.95)
      );
  }

  .resumes-menu-shell {
    width: 100vw;
    height: 100vh;
    height: 100dvh;
  }
</style>
