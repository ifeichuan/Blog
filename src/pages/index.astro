---
import "@/styles/tailwind.css";
import HomeIntro from "@/components/HomeIntro.astro";
import StaggeredMenu from "@/components/homepage/StaggeredMenu.astro";

const isDev = import.meta.env.DEV;
const menuItems = [
  { label: "About", link: "/about", ariaLabel: "Go to About" },
  { label: "Posts", link: "/blogs", ariaLabel: "Go to Posts" },
  { label: "Labs", link: "/labs", ariaLabel: "Go to Labs" },
  { label: "Resumes", link: "/resumes", ariaLabel: "Go to Resumes" },
];
const socialItems = [
  { label: "GitHub", link: "https://github.com" },
  { label: "Email", link: "mailto:hi@feichuan.dev" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Feichuan</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f5f4ed" />
    {
      isDev && (
        <script is:inline type="module">
          import { injectIntoGlobalHook } from "/@react-refresh";
          injectIntoGlobalHook(window);
          window.$RefreshReg$ = () => {};
          window.$RefreshSig$ = () => (type) => type;
        </script>
      )
    }
  </head>
  <body>
    <HomeIntro />
    <StaggeredMenu
      position="right"
      items={menuItems}
      socialItems={socialItems}
      colors={["#DA702C", "#4385BE"]}
      accentColor="#DA702C"
      menuButtonColor="#141413"
      openMenuButtonColor="#141413"
      logoUrl="/feichuan-logo.svg"
    />
    <div id="homepage-root"></div>

    <script>
      const target = document.getElementById("homepage-root");

      if (target) {
        import("@/entries/homepage")
          .then(({ mountHomepage }) => mountHomepage(target))
          .catch((error) => {
            console.error("Failed to load homepage", error);
            target.textContent = "Unable to load the homepage.";
            target.classList.add("homepage-error");
            window.dispatchEvent(new Event("homepage:error"));
          });
      }
    </script>
  </body>
</html>

<style is:global>
  html, body {
    overflow-y: auto !important;
    height: auto !important;
  }

  html[data-intro-active="true"],
  html[data-intro-active="true"] body {
    overflow: hidden !important;
  }

  .homepage-error {
    min-height: 100dvh;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    color: #141413;
    background: #f5f4ed;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }
</style>
