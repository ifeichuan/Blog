---
import "@/styles/tailwind.css";
import { DappledLight } from "@/components/DappledLight";
import { HeroContent } from "@/components/HeroContent";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Feichuan</title>
  </head>
  <body>
    <main class="relative min-h-screen flex items-center justify-center p-4">
      <section
        class="relative z-1 w-[99vw] h-[99vh] rounded-2xl overflow-hidden"
      >
        <div class="absolute inset-0 z-0">
          <DappledLight client:only="react" />
        </div>
        <div
          class="relative z-10 h-full flex items-center justify-center text-near-black"
        >
          <HeroContent client:only="react" />
        </div>
      </section>
    </main>
  </body>
</html>
