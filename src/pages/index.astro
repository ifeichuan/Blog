---
import "@/styles/tailwind.css";
import Intro from "@/components/layout/Intro.astro";
import SiteMenu from "@/components/layout/SiteMenu.astro";

const isDev = import.meta.env.DEV;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Feichuan</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f5f4ed" />
    <link
      href="https://fontsapi.zeoseven.com/442/main/result.css"
      onload="this.rel='stylesheet'"
      rel="preload"
      as="style"
      crossorigin
    />
    <noscript><link rel="stylesheet" href="https://fontsapi.zeoseven.com/442/main/result.css" /></noscript>
    <style>
      body {
        font-family: "Maple Mono NF CN", system-ui, sans-serif;
      }
    </style>
    {
      isDev && (
        <script is:inline type="module">
          import { injectIntoGlobalHook } from "/@react-refresh";
          injectIntoGlobalHook(window);
          window.$RefreshReg$ = () => {};
          window.$RefreshSig$ = () => (type) => type;
        </script>
      )
    }
  </head>
  <body>
    <Intro />
    <SiteMenu />
    <div id="homepage-root" class="homepage-intro-slot"></div>

    <script>
      const target = document.getElementById("homepage-root");

      if (target) {
        import("@/entries/homepage")
          .then(({ mountHomepage }) => mountHomepage(target))
          .catch((error) => {
            console.error("Failed to load homepage", error);
            target.textContent = "Unable to load the homepage.";
            target.classList.add("homepage-error");
            window.dispatchEvent(new Event("homepage:error"));
          });
      }
    </script>
  </body>
</html>

<style is:global>
  html, body {
    overflow-y: auto !important;
    height: auto !important;
  }

  html[data-intro-active="true"],
  html[data-intro-active="true"] body {
    overflow: hidden !important;
  }

  .homepage-error {
    min-height: 100dvh;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    color: #141413;
    background: #f5f4ed;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .homepage-intro-slot {
    --clip-top: 50%;
    --clip-right: 38%;
    --clip-bottom: 50%;
    --clip-left: 38%;
    --clip-height: 100vh;
    --clip-width: 100%;
    width: var(--clip-width);
    height: var(--clip-height);
    clip-path: inset(
      var(--clip-top) var(--clip-right) var(--clip-bottom) var(--clip-left)
    );
  }

  html[data-intro-active="true"] .homepage-intro-slot {
    position: relative;
    z-index: 1002;
  }

  @supports (height: 100dvh) {
    .homepage-intro-slot {
      --clip-height: 100dvh;
    }
  }
</style>
