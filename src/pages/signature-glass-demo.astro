---
import { SignatureGlassDemo } from '@/components/GlassSignature'
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Glass Signature Demo</title>
  </head>
  <body>
    <SignatureGlassDemo client:only="react" />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    min-height: 100%;
    overflow: hidden;
    background: #ede9df;
  }

  body {
    font-family: "Maple Mono NF CN", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
  }

  .signature-scene {
    position: relative;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    color: #27251f;
    isolation: isolate;
    background:
      linear-gradient(115deg, rgb(246 242 229 / 0.9), rgb(221 232 221 / 0.74) 44%, rgb(232 221 196 / 0.86)),
      #ede9df;
  }

  .signature-scene::before {
    position: absolute;
    inset: -18%;
    content: "";
    background:
      radial-gradient(ellipse 34% 18% at 20% 24%, rgb(255 239 168 / 0.44), transparent 68%),
      radial-gradient(ellipse 28% 16% at 76% 18%, rgb(156 191 173 / 0.3), transparent 72%),
      radial-gradient(ellipse 30% 16% at 62% 76%, rgb(255 221 151 / 0.35), transparent 72%),
      linear-gradient(126deg, transparent 0 28%, rgb(65 88 61 / 0.12) 29% 31%, transparent 32% 100%);
    filter: blur(10px);
    transform: rotate(-7deg);
    animation: dapple-drift 16s ease-in-out infinite alternate;
    z-index: 0;
  }

  .signature-scene::after {
    position: absolute;
    inset: 0;
    content: "";
    background-image:
      linear-gradient(rgb(48 71 58 / 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgb(48 71 58 / 0.045) 1px, transparent 1px);
    background-size: 38px 38px;
    mask-image: radial-gradient(circle at 50% 48%, black 0 46%, transparent 74%);
    opacity: 0.55;
    z-index: 1;
  }

  .signature-filter-bank {
    position: fixed;
    width: 0;
    height: 0;
  }

  .dappled-canvas {
    position: absolute !important;
    inset: -8% !important;
    width: 116% !important;
    height: 116% !important;
    opacity: 0.92;
    filter: blur(0.6px) saturate(1.04);
    mix-blend-mode: soft-light;
    z-index: 1;
  }

  .bubble-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }

  .bubble-card {
    position: absolute;
    left: var(--x);
    top: var(--y);
    display: grid;
    gap: 0.45rem;
    width: clamp(128px, 15vw, 188px);
    min-height: 86px;
    padding: 16px 18px;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.52);
    border-radius: 999px;
    background:
      linear-gradient(142deg, rgb(255 255 255 / 0.5), rgb(236 247 234 / 0.22) 46%, rgb(255 214 145 / 0.18)),
      rgb(255 255 255 / 0.12);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.88),
      inset 14px 18px 32px rgb(255 255 255 / 0.16),
      0 20px 56px rgb(69 61 42 / 0.16),
      1px 0 0 rgb(255 79 56 / 0.28),
      -1px 0 0 rgb(45 154 255 / 0.3);
    backdrop-filter: blur(20px) saturate(1.42) contrast(1.04);
    filter: url("#bubble-card-glass") drop-shadow(0 14px 30px rgb(85 78 52 / 0.14));
  }

  .bubble-card::before {
    position: absolute;
    inset: 8px 16px auto auto;
    width: 42%;
    height: 28%;
    content: "";
    border-radius: 999px;
    background: rgb(255 255 255 / 0.58);
    filter: blur(7px);
    transform: rotate(-18deg);
  }

  .bubble-card span,
  .bubble-card small {
    position: relative;
    letter-spacing: 0;
  }

  .bubble-card span {
    font-size: clamp(1rem, 1.55vw, 1.35rem);
    font-weight: 600;
  }

  .bubble-card small {
    font-size: 0.72rem;
    color: rgb(39 37 31 / 0.58);
  }

  .signature-shell {
    position: absolute;
    inset: clamp(42px, 8vw, 112px);
    display: grid;
    place-items: center;
    pointer-events: none;
    z-index: 3;
  }

  .glass-signature {
    width: min(86vw, 1120px);
    height: auto;
    overflow: visible;
    filter:
      drop-shadow(0 22px 44px rgb(73 88 70 / 0.16))
      drop-shadow(0 0 18px rgb(255 255 255 / 0.34));
  }

  .glass-signature__backdrop {
    width: 100%;
    height: 100%;
    border-radius: 999px;
    background:
      radial-gradient(ellipse at 18% 22%, rgb(255 255 255 / 0.88), transparent 34%),
      radial-gradient(ellipse at 78% 72%, rgb(86 166 216 / 0.35), transparent 42%),
      linear-gradient(135deg, rgb(255 255 255 / 0.56), rgb(236 249 245 / 0.2) 46%, rgb(255 219 143 / 0.2));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.88),
      inset 0 -16px 28px rgb(82 121 123 / 0.12),
      inset 18px 18px 38px rgb(255 255 255 / 0.22),
      0 0 0 1px rgb(255 255 255 / 0.55);
    opacity: 0.9;
    backdrop-filter: blur(22px) saturate(1.75) contrast(1.08);
  }

  .glass-signature__path {
    stroke: rgb(250 255 250 / 0.86);
    stroke-width: 10;
    mix-blend-mode: screen;
  }

  .glass-signature__path--red {
    stroke: rgb(255 71 48 / 0.52);
    stroke-width: 13;
    mix-blend-mode: screen;
  }

  .glass-signature__path--blue {
    stroke: rgb(31 146 255 / 0.56);
    stroke-width: 13;
    mix-blend-mode: screen;
  }

  .glass-signature__path--spark {
    stroke: rgb(255 255 255 / 0.64);
    stroke-width: 3.2;
    stroke-dasharray: 24 72;
    mix-blend-mode: screen;
  }

  @keyframes dapple-drift {
    from {
      transform: translate3d(-1.4%, -0.8%, 0) rotate(-7deg) scale(1);
    }

    to {
      transform: translate3d(1.6%, 1.1%, 0) rotate(-4deg) scale(1.03);
    }
  }

  @media (max-width: 720px) {
    .signature-shell {
      inset: 9vw 4vw;
    }

    .glass-signature {
      width: 112vw;
    }

    .bubble-card {
      width: 126px;
      min-height: 76px;
      padding: 14px 16px;
    }

    .bubble-card:nth-child(2),
    .bubble-card:nth-child(4) {
      left: auto;
      right: 6%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signature-scene::before {
      animation: none;
    }
  }
</style>
