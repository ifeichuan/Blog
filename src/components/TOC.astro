---
interface MarkdownHeading {
  depth: number;
  slug: string;
  text: string;
}

const { headings } = Astro.props as { headings: MarkdownHeading[] };
---

<nav class="toc-wrapper max-md:opacity-0" aria-label="文章目录">
  <div class="toc-header">目录</div>
  <div class="toc-scroll" data-lenis-prevent>
    <div class="toc-track">
      <div class="toc-indicator"></div>
    </div>
    <ul class="toc-list">
      {
        headings.map((heading) => (
          <li
            class="toc-item"
            style={`--depth: ${heading.depth - 2}`}
          >
            <a
              href={`#${heading.slug}`}
              class="toc-link"
              data-id={heading.slug}
              data-depth={heading.depth}
            >
              {heading.text}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<script>
  const wrapper = document.querySelector(".toc-wrapper") as HTMLElement;
  const scrollArea = document.querySelector(".toc-scroll") as HTMLElement;
  const indicator = document.querySelector(".toc-indicator") as HTMLElement;
  const tocLinks = document.querySelectorAll(".toc-link");

  const setActive = (link: HTMLElement) => {
    const item = link.closest(".toc-item") as HTMLElement;
    if (!item) return;
    // 指示条位置：相对 toc-scroll 的 top
    const scrollRect = scrollArea.getBoundingClientRect();
    const itemRect = item.getBoundingClientRect();
    indicator.style.top = `${itemRect.top - scrollRect.top + scrollArea.scrollTop}px`;
    indicator.style.height = `${itemRect.height}px`;
    indicator.style.opacity = "1";

    // 将激活项滚入可视区域
    const itemTop = item.offsetTop;
    const areaH = scrollArea.clientHeight;
    const scrollTop = scrollArea.scrollTop;
    if (itemTop < scrollTop + 24 || itemTop + itemRect.height > scrollTop + areaH - 24) {
      scrollArea.scrollTo({ top: itemTop - areaH / 3, behavior: "smooth" });
    }
  };

  // 构建 heading 数组
  const headingEls: HTMLElement[] = [];
  tocLinks.forEach((link) => {
    const id = link.getAttribute("data-id")!;
    const el = document.getElementById(id);
    if (el) headingEls.push(el);
  });

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const id = entry.target.getAttribute("id")!;
        const link = document.querySelector(`.toc-link[data-id='${id}']`) as HTMLElement;
        if (!link) return;

        tocLinks.forEach((l) => l.classList.remove("is-active"));
        link.classList.add("is-active");
        setActive(link);
      });
    },
    { rootMargin: "-80px 0px -80% 0px", threshold: 0 },
  );

  headingEls.forEach((h) => observer.observe(h));
</script>

<style>
  .toc-wrapper {
    position: relative;
    color: oklch(0.45 0.03 260);
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  :global(.dark) .toc-wrapper {
    color: oklch(0.65 0.025 260);
  }

  .toc-header {
    font-weight: 600;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: oklch(0.55 0.02 260);
    padding-left: 14px;
    margin-bottom: 8px;
  }
  :global(.dark) .toc-header {
    color: oklch(0.58 0.02 260);
  }

  .toc-scroll {
    position: relative;
    max-height: 40vh;
    overflow-y: auto;
    overscroll-behavior: contain;
    /* 细窄滚动条 */
    scrollbar-width: thin;
    scrollbar-color: oklch(0.8 0.01 260) transparent;
  }
  :global(.dark) .toc-scroll {
    scrollbar-color: oklch(0.35 0.02 260) transparent;
  }

  .toc-track {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: oklch(0.9 0.005 260);
    border-radius: 1px;
  }
  :global(.dark) .toc-track {
    background: oklch(0.25 0.015 260);
  }

  .toc-indicator {
    position: absolute;
    left: 0;
    width: 2px;
    border-radius: 1px;
    background: oklch(0.55 0.18 260);
    opacity: 0;
    transition: top 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                height 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.2s ease;
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc-item {
    padding-left: calc(14px + var(--depth, 0) * 12px);
  }

  .toc-link {
    display: block;
    padding: 3px 8px 3px 0;
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .toc-link:hover {
    color: oklch(0.45 0.2 260);
  }
  :global(.dark) .toc-link:hover {
    color: oklch(0.78 0.15 260);
  }

  .toc-link.is-active {
    color: oklch(0.45 0.2 260);
    font-weight: 600;
  }
  :global(.dark) .toc-link.is-active {
    color: oklch(0.78 0.15 260);
  }
</style>
