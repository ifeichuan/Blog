---
import { Image } from "astro:assets";
import { NavList, SITE_TITLE } from "../consts";
---

<header
  class="nav w-screen mix-blend-difference h-16 z-50 font-serif fixed top-0 left-0 right-0 mx-auto shadow-inner text-white backdrop-blur-lg -translate-y-full"
  data-status="grow"
>
  <div class="flex justify-between h-full w-full p-5">
    <div class="left mix-blend-overlay">
      <a
        id="logoText"
        class="h-full flex justify-center items-center text-3xl"
        href="/">{SITE_TITLE}</a
      >
    </div>
    <div class="center search"></div>
    <div class="right h-full">
      <nav class="flex h-full">
        {
          NavList.map((item) => (
            <a
              class="mix-blend-overlay text-2xl  h-full flex justify-center items-center hover:bg-blue-500 rounded-[9999px] p-2 data-[current]:underline  data-[current]:text-blue-400"
              href={item.href}
              data-href={item.href}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</header>
<script>
  import gsap from "gsap";
  import ScrambleTextPlugin from "gsap/ScrambleTextPlugin";
  import { debounce, throttle } from "es-toolkit";
  import { emitter } from "../lib/utils";
  gsap.registerPlugin(ScrambleTextPlugin);
  const NAV_GROW_WIDTH = "100%";
  const NAV_SHRINK_WIDTH = "40rem";
  const isNearWindowTop = () => {
    return window.scrollY <= 30;
  };
  let navStatus: string = "undefined";
  const navEl = document.querySelector(".nav") as HTMLElement | null;
  const setNavStatus = (status: "grow" | "shrink") => {
    navStatus = status;
    navEl?.setAttribute("data-status", status);
  };
  const setProgress = (scroll: number, limit: number) => {
    const progress = limit > 0 ? Math.min(1, Math.max(0, scroll / limit)) : 0;
    navEl?.style.setProperty("--scroll-p", progress.toString());
  };
  const debounceNav = throttle((direction: string) => {
    if (direction === "up" && isNearWindowTop() && navStatus === "shrink") {
      console.log(navStatus);
      setNavStatus("grow");
      gsap.to(".nav", {
        translateY: "0",
        width: NAV_GROW_WIDTH,
        borderRadius: "0",
        duration: 0.3,
        ease: "none",
      });
    } else if (
      (direction === "down" && navStatus === "grow") ||
      navStatus === "undefined"
    ) {
      console.log(navStatus);
      setNavStatus("shrink");
      gsap.to(".nav", {
        translateY: "20px",
        width: NAV_SHRINK_WIDTH,
        borderRadius: "99999px",
        duration: 0.3,
        ease: "none",
      });
    }
  }, 100);
  document.addEventListener("DOMContentLoaded", (e) => {
    console.log("Nav DOMContentLoaded");
    emitter.on("Intro:end", () => {
      console.log("HALos");
      gsap.to(".nav", {
        y: 0,
        duration: 1,
        // position: "sticky",
        ease: "power2.inOut",
      });
    });
  });
  window.addEventListener("load", (e) => {
    console.log("Nav loaded");
    // gsap.set(".nav", { y: "-100%" });
    // const logoText = document.getElementById("logoText") as HTMLAnchorElement;
    // const nav = document.querySelector(".nav") as HTMLElement;
    // const linkArray = document.querySelectorAll(
    //   ".nav .right a"
    // ) as NodeListOf<HTMLAnchorElement>;
    // console.log(linkArray);

    // linkArray.forEach((link) => {
    //   const path = link.dataset.href;
    //   console.log(path, window.location.pathname);
    //   if (path === window.location.pathname) {
    //     link.dataset.current = "true";
    //   }
    // });
    window.addEventListener("Intro:start", () => {
      // gsap.to(nav, {
      //   y: "-100%",
      //   duration: 0.1,
      //   ease: "power2.inOut",
      // });
    });

    window.addEventListener("Intro:end", () => {
      console.log("ENd");
    });
    window.addEventListener("lenis-scroll", (e: Event) => {
      const detail = (e as CustomEvent).detail || { scroll: 0, limit: 0 };
      setProgress(detail.scroll, detail.limit);
    });
    window.addEventListener("wheel", (e: any) => {
      const direction = (e.wheelDelta as number) >= 0 ? "up" : "down";
      // console.log(window.scrollY, e, direction);

      debounceNav(direction);
    });
  });
</script>
<style>
  .nav {
    background: transparent;
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
    --scroll-p: 0;
    --progress-color: rgba(59, 130, 246, 0.9);
    --progress-line-thickness: 4px;
    --progress-ring-thickness: 3px;
    position: fixed;
    overflow: visible;
  }

  .nav::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    height: var(--progress-line-thickness);
    width: calc(var(--scroll-p) * 100%);
    background: var(--progress-color);
    transform-origin: left center;
    opacity: 0;
    pointer-events: none;
    isolation: isolate;
  }

  .nav::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: var(--progress-ring-thickness);
    background: conic-gradient(
      var(--progress-color) calc(var(--scroll-p) * 360deg),
      rgba(203, 85, 85, 0.2) 0
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    pointer-events: none;
  }

  .nav[data-status="grow"]::before {
    opacity: 1;
  }

  .nav[data-status="shrink"]::after {
    opacity: 1;
  }

  .nav[data-status="grow"] {
    --progress-line-thickness: 4px;
  }

  .nav[data-status="shrink"] {
    --progress-ring-thickness: 3px;
  }
</style>
