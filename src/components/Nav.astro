---
import { Image } from "astro:assets";
import { NavList, SITE_TITLE } from "../consts";
---

<header
  class="nav w-screen mix-blend-difference h-16 z-50 font-serif fixed top-[28px] left-0 right-0 mx-auto shadow-inner text-white backdrop-blur-lg"
>
  <div class="flex justify-between h-full w-full p-5">
    <div class="left mix-blend-overlay">
      <a
        id="logoText"
        class="h-full flex justify-center items-center text-3xl"
        href="/">{SITE_TITLE}</a
      >
    </div>
    <div class="center search"></div>
    <div class="right h-full">
      <nav class="flex h-full">
        {
          NavList.map((item) => (
            <a
              class="mix-blend-overlay text-2xl  h-full flex justify-center items-center hover:bg-blue-500 rounded-[9999px] p-2 data-[current]:underline  data-[current]:text-blue-400"
              href={item.href}
              data-href={item.href}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</header>
<script>
  import gsap from "gsap";

  const navEl = document.querySelector(".nav") as HTMLElement | null;
  let introActive = false;

  const lockScroll = () => {
    document.documentElement.style.overflow = "hidden";
    document.body.style.overflow = "hidden";
  };

  const unlockScroll = () => {
    document.documentElement.style.overflow = "";
    document.body.style.overflow = "";
  };

  const blockScroll = (e: Event) => {
    if (!introActive) return;
    e.preventDefault();
  };

  const blockKeys = (e: KeyboardEvent) => {
    if (!introActive) return;
    const keys = [
      "ArrowUp",
      "ArrowDown",
      "PageUp",
      "PageDown",
      "Home",
      "End",
      " ",
    ];
    if (keys.includes(e.key)) {
      e.preventDefault();
    }
  };

  const setProgress = (scroll: number, limit: number) => {
    if (introActive) return;
    const progress = limit > 0 ? Math.min(1, Math.max(0, scroll / limit)) : 0;
    navEl?.style.setProperty("--scroll-p", progress.toString());
  };

  if (navEl) {
    gsap.set(navEl, { y: "-100%" });
  }

  window.addEventListener("Intro:start", () => {
    introActive = true;
    lockScroll();
  });

  window.addEventListener("Intro:end", () => {
    introActive = false;
    unlockScroll();
    if (navEl) {
      gsap.to(navEl, {
        y: 0,
        duration: 1,
        ease: "power2.inOut",
      });
    }
  });

  document.addEventListener("wheel", blockScroll, { passive: false });
  document.addEventListener("touchmove", blockScroll, { passive: false });
  document.addEventListener("keydown", blockKeys);

  window.addEventListener("lenis-scroll", (e: Event) => {
    const detail = (e as CustomEvent).detail || { scroll: 0, limit: 0 };
    setProgress(detail.scroll, detail.limit);
  });

  window.addEventListener("scroll", () => {
    const scroll = window.scrollY;
    const limit = document.documentElement.scrollHeight - window.innerHeight;
    setProgress(scroll, limit);
  });
</script>
<style>
  .nav {
    background: transparent;
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
    --scroll-p: 0;
    --progress-color: rgba(59, 130, 246, 0.9);
    --progress-line-thickness: 4px;
    position: fixed;
    overflow: visible;
  }

  .nav::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    height: var(--progress-line-thickness);
    width: calc(var(--scroll-p) * 100%);
    background: var(--progress-color);
    transform-origin: left center;
    pointer-events: none;
  }
</style>
