<div id="point1" class=""></div>
<div id="point2" class=""></div>
<style>
  #point1,
  #point2 {
    position: fixed;
    top: 0;
    left: 0;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    z-index: 1000000;
    mix-blend-mode: multiply;
    pointer-events: none;
    background: var(--color-blue-400);
    will-change: transform;
    contain: layout style size;
  }
  #point2 {
    width: 3rem;
    height: 3rem;
    background: var(--color-sky-200);
    transition: width 0.2s ease-out, height 0.2s ease-out,
      border-radius 0.2s ease-out, box-shadow 0.2s ease-out;
    backdrop-filter: blur(0.5px) brightness(1.1) saturate(1.5);
    z-index: 999999;
  }
</style>
<script>
  window.addEventListener("load", () => {
    const g1 = document.getElementById("point1") as HTMLDivElement;
    const g2 = document.getElementById("point2") as HTMLDivElement;
    if (!g1 || !g2) return;

    let g1Width = g1.offsetWidth / 2;
    let g2Width = g2.offsetWidth / 2;
    let isHovering = false;
    let lastX = 0;
    let lastY = 0;
    let rafId = 0;

    const updatePosition = () => {
      g1.style.transform = `translate3d(${lastX - g1Width}px, ${lastY - g1Width}px, 0)`;
      if (!isHovering) {
        g2.style.transform = `translate3d(${lastX - g2Width}px, ${lastY - g2Width}px, 0)`;
      }
      rafId = 0;
    };

    const setPosition = (x: number, y: number) => {
      lastX = x;
      lastY = y;
      if (!rafId) {
        rafId = requestAnimationFrame(updatePosition);
      }
    };

    const onPointerMove = (e: PointerEvent) => {
      setPosition(e.clientX, e.clientY);
    };

    const onMouseOver = (e: MouseEvent) => {
      const target = e.target as Element;
      if (target.classList.contains("g-animation")) {
        isHovering = true;
        const rect = target.getBoundingClientRect();
        const style = getComputedStyle(target);
        g2.style.width = `${rect.width + 20}px`;
        g2.style.height = `${rect.height + 20}px`;
        const borderRadius = style.borderRadius.slice(
          0,
          style.borderRadius.lastIndexOf("p"),
        );
        g2.style.mixBlendMode = "soft-light";
        g2.style.boxShadow = "inset 0 0 5px rgba(0,0,0,0.2)";
        g2.style.borderRadius =
          Math.max(parseInt(borderRadius) / 16, 1) + "rem";
        g2.style.transform = `translate3d(${rect.left - 10}px, ${rect.top - 10}px, 0)`;
      }
    };

    const onMouseOut = (e: MouseEvent) => {
      const target = e.target as Element;
      if (target.classList.contains("g-animation")) {
        isHovering = false;
        g2.style.width = `3rem`;
        g2.style.height = `3rem`;
        g2.style.borderRadius = `50%`;
        g2.style.mixBlendMode = "multiply";
        g2.style.boxShadow = "none";
      }
    };

    const onWheel = (e: WheelEvent) => {
      if (isHovering) {
        onMouseOut(e);
        setPosition(e.clientX, e.clientY);
      }
    };

    window.addEventListener("pointermove", onPointerMove, { passive: true });
    window.addEventListener("mouseover", onMouseOver, { passive: true });
    window.addEventListener("mouseout", onMouseOut, { passive: true });
    window.addEventListener("wheel", onWheel, { passive: true });

    // 初始标记 + 增量更新，避免每次 DOM 变化都全量扫描
    const markInteractiveElements = (root: Element | Document) => {
      const elements = root.querySelectorAll("a,button,pre,code,img");
      elements.forEach((e) => {
        if (!e.classList.contains("g-not") && !e.closest(".g-not")) {
          e.classList.add("g-animation");
        }
      });
    };

    // 初始标记
    markInteractiveElements(document);

    // 只对新增节点做标记
    const observer = new MutationObserver((mutations) => {
      for (const mutation of mutations) {
        for (const node of mutation.addedNodes) {
          if (node.nodeType === Node.ELEMENT_NODE) {
            const el = node as Element;
            // 标记新增节点本身
            if (el.matches("a,button,pre,code,img")) {
              if (!el.classList.contains("g-not") && !el.closest(".g-not")) {
                el.classList.add("g-animation");
              }
            }
            // 标记新增节点的子元素
            markInteractiveElements(el);
          }
        }
      }
    });
    observer.observe(document.documentElement, {
      childList: true,
      subtree: true,
    });
  });
</script>
