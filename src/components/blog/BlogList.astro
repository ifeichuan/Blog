---
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.dateCreated.valueOf() - a.data.dateCreated.valueOf(),
);

function formatDate(date: Date) {
  return date.toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}
---

<div class="blog-list">
  {
    posts.map((p) => {
      const path = `/blogs/${p.id}`;
      return (
        <article class="blog-item">
          <a href={path} class="post-link" data-astro-prefetch>
            <time datetime={p.data.dateCreated.toISOString()}>
              {formatDate(p.data.dateCreated)}
            </time>
            <h2 class="post-title">{p.data.title}</h2>
            {p.data.description && (
              <p class="post-desc">{p.data.description}</p>
            )}
          </a>
        </article>
      );
    })
  }
</div>

<style>
  .blog-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .blog-item {
    border-bottom: 1px solid color-mix(in srgb, currentColor 10%, transparent);
  }

  .blog-item:first-child {
    border-top: 1px solid color-mix(in srgb, currentColor 10%, transparent);
  }

  .post-link {
    display: block;
    padding: 1.75rem 0;
    color: inherit;
    text-decoration: none;
    transition: padding-left 280ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .post-link:hover {
    padding-left: 0.75rem;
  }

  .post-link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
    border-radius: 2px;
  }

  .post-link time {
    display: block;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, currentColor 40%, transparent);
    font-variant-numeric: tabular-nums;
    margin-bottom: 0.5rem;
  }

  .post-title {
    margin: 0;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .post-desc {
    margin: 0.5rem 0 0;
    font-size: 0.8rem;
    line-height: 1.6;
    color: color-mix(in srgb, currentColor 55%, transparent);
    max-width: 560px;
  }

  @media (max-width: 640px) {
    .post-link {
      padding: 1.25rem 0;
    }

    .post-link:hover {
      padding-left: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-link {
      transition: none;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  let initializationTimer;

  function initScrollAnimations() {
    const blogItems = document.querySelectorAll(".blog-item");
    const scroller = document.querySelector(".smooth-wrapper");

    if (!blogItems.length || !scroller) {
      setTimeout(initScrollAnimations, 100);
      return;
    }

    ScrollTrigger.getAll().forEach((st) => {
      if (typeof st.vars.id === "string" && st.vars.id.startsWith("blog-item-")) {
        st.kill();
      }
    });

    blogItems.forEach((item, index) => {
      gsap.set(item, {
        y: 40,
        opacity: 0,
      });

      gsap.to(item, {
        y: 0,
        opacity: 1,
        duration: 0.7,
        delay: index * 0.05,
        ease: "power2.out",
        scrollTrigger: {
          trigger: item,
          scroller: ".smooth-wrapper",
          start: "top 90%",
          toggleActions: "play none none none",
          id: `blog-item-${index}`,
        },
      });
    });

    ScrollTrigger.refresh();
  }

  function scheduleScrollAnimations() {
    if (initializationTimer) window.clearTimeout(initializationTimer);
    initializationTimer = window.setTimeout(initScrollAnimations, 500);
  }

  window.addEventListener("load", () => {
    scheduleScrollAnimations();
  });

  document.addEventListener("astro:page-load", () => {
    scheduleScrollAnimations();
  });
</script>
