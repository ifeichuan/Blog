---
import { getCollection } from "astro:content";
import { umami } from "@/actions/umami";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.dateCreated.valueOf() - a.data.dateCreated.valueOf(),
);

const paths = posts.map((post) => `/blogs/${post.id}`);
const [activeVisitors, views] = await Promise.all([
  umami.getActiveVisitors(),
  umami.getVisitorsBatch(paths),
]);

const viewsByPath = new Map(views.map((item) => [item.path, item]));
---

<div class="blog-list w-full">
  <div class="visitor-count">
    当前 <span>{activeVisitors}</span> 人正在看
  </div>
  <div class="post-list">
    {
      posts.map((p) => {
        const path = `/blogs/${p.id}`;
        const stats = viewsByPath.get(path);
        return (
          <article class="blog-item">
            <a href={path} class="post-row" data-astro-prefetch>
              <time datetime={p.data.dateCreated.toISOString()}>
                {p.data.dateCreated.toLocaleDateString()}
              </time>
              <h2 class="post-title">{p.data.title}</h2>
              <span class="post-meta">
                <i class="fa-regular fa-eye fa-sm" aria-hidden="true" />
                <span>{stats?.totalVisitors ?? 0} 人看过</span>
              </span>
              <span class="post-arrow" aria-hidden="true">↗</span>
            </a>
          </article>
        );
      })
    }
  </div>
</div>

<style>
  .visitor-count {
    margin-bottom: 1.5rem;
    color: color-mix(in srgb, currentColor 58%, transparent);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-align: right;
  }

  .visitor-count span {
    color: currentColor;
    font-variant-numeric: tabular-nums;
  }

  .post-list {
    border-top: 1px solid color-mix(in srgb, currentColor 18%, transparent);
  }

  .post-row {
    display: grid;
    grid-template-columns: minmax(6rem, auto) minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 1rem;
    min-height: 4.25rem;
    padding: 0.75rem 0.25rem;
    border-bottom: 1px solid color-mix(in srgb, currentColor 18%, transparent);
    color: inherit;
    text-decoration: none;
    transition: background-color 180ms ease, color 180ms ease;
  }

  .post-row:hover {
    background: color-mix(in srgb, currentColor 6%, transparent);
  }

  .post-row:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -2px;
  }

  .post-row time,
  .post-meta {
    color: color-mix(in srgb, currentColor 58%, transparent);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .post-row time {
    font-variant-numeric: tabular-nums;
  }

  .post-meta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .post-title {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    color: currentColor;
    font-family: var(--font-serif);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    font-weight: 600;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .post-arrow {
    font-size: 1.1rem;
    line-height: 1;
    transition: transform 180ms ease;
  }

  .post-row:hover .post-arrow {
    transform: translate(0.15rem, -0.15rem);
  }

  @media (max-width: 640px) {
    .post-row {
      grid-template-columns: 4.75rem minmax(0, 1fr) auto;
      gap: 0.75rem;
    }

    .post-meta {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-row,
    .post-arrow {
      transition: none;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  let initializationTimer;

  function initScrollAnimations() {
    const blogItems = document.querySelectorAll(".blog-item");
    const scroller = document.querySelector(".smooth-wrapper");

    if (!blogItems.length || !scroller) {
      setTimeout(initScrollAnimations, 100);
      return;
    }

    ScrollTrigger.getAll().forEach((st) => {
      if (typeof st.vars.id === "string" && st.vars.id.startsWith("blog-item-")) {
        st.kill();
      }
    });

    blogItems.forEach((item, index) => {
      gsap.set(item, {
        y: 100,
        opacity: 0.8,
        filter: "blur(5px)",
      });

      gsap.to(item, {
        y: 0,
        filter: "blur(0px)",
        opacity: 1,
        duration: 1,
        ease: "power3.out",
        scrollTrigger: {
          trigger: item,
          scroller: ".smooth-wrapper",
          start: "top bottom",
          end: "top center",
          toggleActions: "play none none none",
          id: `blog-item-${index}`,
        },
      });
    });

    ScrollTrigger.refresh();
  }

  function scheduleScrollAnimations() {
    if (initializationTimer) window.clearTimeout(initializationTimer);
    initializationTimer = window.setTimeout(initScrollAnimations, 500);
  }

  window.addEventListener("load", () => {
    scheduleScrollAnimations();
  });

  document.addEventListener("astro:page-load", () => {
    scheduleScrollAnimations();
  });
</script>
