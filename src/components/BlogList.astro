---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.dateCreated.valueOf() - a.data.dateCreated.valueOf(),
);
import { umami } from "@/actions/umami";

for (let p of posts) {
}
let views = await Promise.all(
  posts.map(async (p) => {
    console.log("Getting views for post:", p.data.title);
    let path = "/blog/" + p.filePath?.split("content/")[1].split(".md")[0];
    return {
      views: await umami.getVisitors(path),
      path: path,
    };
  }),
);

console.log("Views data:", views);
---

<div class="ssss flex flex-col gap-20 w-full">
  {
    posts.map((p, index) => {
      return (
        <article class="w-full h-full blog-item">
          <a
            href={`/blog/${p.id}`}
            class="w-full h-80  block relative overflow-hidden rounded-lg **:font-serif"
            data-random-container
            data-astro-prefetch
          >
            <Image
              src={
                p.data.banner || `https://picsum.photos/seed/${p.id}/800/600`
              }
              height={600}
              width={800}
              alt={p.data.title}
              class="object-cover absolute w-full h-full rounded-lg"
              loading="lazy"
              data-random-seed={!p.data.banner ? p.id : undefined}
              data-random-base={
                !p.data.banner ? "https://picsum.photos" : undefined
              }
            />
            <time class="post-time absolute left-2 top-2 post-card">
              {p.data.dateCreated.toLocaleDateString()}
            </time>
            <div class="post-meta absolute top-2 right-2 post-card">
              <div class="unit flex items-center ">
                <i class="fa-regular fa-eye fa-sm" />
                <span class="ml-1">
                  <span id="views" data-href={views[index]?.path}>
                    {views[index]?.views.totalPageviews || 0}
                  </span>
                  热度
                </span>
              </div>
            </div>
            {/* 根据 p 元素的内容动态修改h2位置 */}
            <h2
              transition:name="title"
              class="title left-0 absolute bg-white/40 p-2 backdrop-blur-2xl w-full mix-blend-overlay text-3xl [text-shadow:0_0_5px_rgba(0,0,0,0.8)] font-extrabold "
            >
              {p.data.title}
            </h2>
            <p
              class="description absolute left-0 bottom-0 w-full max-h-1/3 text-lg bg-white/60 backdrop-blur-2xl font-serif"
              class:list={!p.data.description ? "p-0" : "p-4.5"}
            >
              {p.data.description}
            </p>
          </a>
        </article>
      );
    })
  }
</div>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { actions } from "astro:actions";
  gsap.registerPlugin(ScrollTrigger);

  const articles = document.querySelectorAll("article");
  articles.forEach((article) => {
    const description = article.querySelector(".description") as HTMLElement;
    const title = article.querySelector(".title") as HTMLElement;

    if (description && title) {
      const updateTitlePosition = () => {
        const descriptionHeight = description.offsetHeight;
        title.style.bottom = `${descriptionHeight - 1}px`;
      };

      // 初始设置
      updateTitlePosition();

      // 监听窗口大小变化
      window.addEventListener("resize", updateTitlePosition);
    }
  });

  const randomImages = document.querySelectorAll<HTMLImageElement>(
    "img[data-random-seed]",
  );
  const resizeObservers: ResizeObserver[] = [];

  const buildSrc = (
    base: string,
    seed: string,
    width: number,
    height: number,
    scale = 1,
  ) => {
    const w = Math.max(1, Math.round(width * scale));
    const h = Math.max(1, Math.round(height * scale));
    return `${base}/seed/${seed}/${w}/${h}`;
  };

  const applyAdaptiveSrc = (img: HTMLImageElement, rect: DOMRectReadOnly) => {
    const seed = img.dataset.randomSeed;
    const base = img.dataset.randomBase || "https://picsum.photos";
    if (!seed || rect.width === 0 || rect.height === 0) return;

    const primary = buildSrc(base, seed, rect.width, rect.height, 1);
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    const retina = buildSrc(base, seed, rect.width, rect.height, dpr);
    img.src = primary;
    img.srcset = `${primary} 1x, ${retina} 2x`;
  };

  randomImages.forEach((img) => {
    const container = img.closest<HTMLElement>("[data-random-container]");
    if (!container) return;

    applyAdaptiveSrc(img, container.getBoundingClientRect());

    const observer = new ResizeObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.target === container) {
          applyAdaptiveSrc(img, entry.contentRect);
        }
      });
    });

    observer.observe(container);
    resizeObservers.push(observer);
  });

  window.addEventListener("beforeunload", () => {
    resizeObservers.forEach((observer) => observer.disconnect());
  });

  // 滚动入场动画
  function initScrollAnimations() {
    const blogItems = document.querySelectorAll(".blog-item");
    const scroller = document.querySelector(".smooth-wrapper");

    if (!blogItems.length || !scroller) {
      console.log("BlogList: Elements not found, retrying...");
      setTimeout(initScrollAnimations, 100);
      return;
    }

    console.log(
      "BlogList: Initializing scroll animations for",
      blogItems.length,
      "items",
    );

    blogItems.forEach((item, index) => {
      // 设置初始状态
      gsap.set(item, {
        y: 100, // 减小初始偏移，减少空白感
        opacity: 0.8,
        filter: "blur(5px)",
      });

      // 创建滚动触发动画
      // gsap.to(item, {
      //   y: 0,
      //   filter: "blur(0px)",
      //   duration: 1, // 缩短动画时间，让动画更快完成
      //   ease: "power3.out",
      //   scrollTrigger: {
      //     trigger: item,
      //     scroller: ".smooth-wrapper",
      //     start: "top bottom-=120", // 恢复原来的提前触发
      //     end: "top center",
      //     toggleActions: "play none none none",
      //     // markers: true,
      //     id: `blog-item-${index}`,
      //   },
      // });

      // 创建滚动触发动画
      gsap.to(item, {
        y: 0,
        filter: "blur(0px)",
        opacity: 1,
        duration: 1,
        ease: "power3.out",
        scrollTrigger: {
          trigger: item,
          scroller: ".smooth-wrapper",
          start: "top bottom", // 减小提前量，元素更接近视口时才触发
          end: "top center",
          toggleActions: "play none none none",
          // markers: true,
          id: `blog-item-${index}`,
        },
      });
    });

    // 强制刷新 ScrollTrigger
    ScrollTrigger.refresh();
    console.log("ScrollTrigger refresh complete");
  }

  // 等待 Lenis 和 ScrollTrigger 初始化完成
  window.addEventListener("load", () => {
    setTimeout(initScrollAnimations, 500);
  });

  // 也监听 astro 的页面加载事件
  document.addEventListener("astro:page-load", () => {
    ScrollTrigger.getAll().forEach((st) => st.kill());
    setTimeout(initScrollAnimations, 500);
  });
</script>
