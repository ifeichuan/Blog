---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.dateCreated.valueOf() - a.data.dateCreated.valueOf()
);
---

<div class="ssss flex flex-col gap-20 w-full">
  {
    posts.map((p) => {
      return (
        <article class="w-full h-full">
          <a
            href={`/blog/${p.id}`}
            class="w-full h-80  block relative overflow-hidden rounded-lg [&_*]:font-serif"
            data-astro-prefetch
          >
            <img
              src={p.data.banner || `https://t.alcy.cc/fj?${p.id}`}
              alt={p.data.title}
              class="object-cover absolute w-full h-full rounded-lg"
              loading="lazy"
            />
            <time class="absolute left-2 top-2 bg-white/40 backdrop-blur-2xl rounded-sm p-0.5">
              {p.data.dateCreated.toLocaleDateString()}
            </time>
            {/* 根据 p 元素的内容动态修改h2位置 */}
            <h2
              transition:name="title"
              class="title left-0 absolute bg-white/40 p-2 backdrop-blur-2xl w-full mix-blend-overlay text-3xl [text-shadow:0_0_5px_rgba(0,0,0,0.8)] font-extrabold "
            >
              {p.data.title}
            </h2>
            <p
              class="description absolute left-0 bottom-0 w-full max-h-1/3 text-lg bg-white/60 backdrop-blur-2xl font-serif"
              class:list={!p.data.description ? "p-0" : "p-4.5"}
            >
              {p.data.description}
            </p>
          </a>
        </article>
      );
    })
  }
</div>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);
  const articles = document.querySelectorAll("article");
  console.log(articles);
  articles.forEach((article) => {
    const description = article.querySelector(".description") as HTMLElement;
    const title = article.querySelector(".title") as HTMLElement;

    if (description && title) {
      const updateTitlePosition = () => {
        const descriptionHeight = description.offsetHeight;
        title.style.bottom = `${descriptionHeight - 1}px`;
      };

      // 初始设置
      updateTitlePosition();

      // 监听窗口大小变化
      window.addEventListener("resize", updateTitlePosition);
    }
  });
</script>
