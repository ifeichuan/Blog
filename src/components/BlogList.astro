---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.dateCreated.valueOf() - a.data.dateCreated.valueOf(),
);
---

<div class="ssss flex flex-col gap-20 w-full">
  {
    posts.map((p) => {
      return (
        <article class="w-full h-full">
          <a
            href={`/blog/${p.id}`}
            class="w-full h-80  block relative overflow-hidden rounded-lg **:font-serif"
            data-random-container
            data-astro-prefetch
          >
            <Image
              src={
                p.data.banner || `https://picsum.photos/seed/${p.id}/800/600`
              }
              height={600}
              width={800}
              alt={p.data.title}
              class="object-cover absolute w-full h-full rounded-lg"
              loading="lazy"
              data-random-seed={!p.data.banner ? p.id : undefined}
              data-random-base={
                !p.data.banner ? "https://picsum.photos" : undefined
              }
            />
            <time class="absolute left-2 top-2 bg-white/40 backdrop-blur-2xl rounded-sm p-0.5">
              {p.data.dateCreated.toLocaleDateString()}
            </time>
            {/* 根据 p 元素的内容动态修改h2位置 */}
            <h2
              transition:name="title"
              class="title left-0 absolute bg-white/40 p-2 backdrop-blur-2xl w-full mix-blend-overlay text-3xl [text-shadow:0_0_5px_rgba(0,0,0,0.8)] font-extrabold "
            >
              {p.data.title}
            </h2>
            <p
              class="description absolute left-0 bottom-0 w-full max-h-1/3 text-lg bg-white/60 backdrop-blur-2xl font-serif"
              class:list={!p.data.description ? "p-0" : "p-4.5"}
            >
              {p.data.description}
            </p>
          </a>
        </article>
      );
    })
  }
</div>

<script>
  const articles = document.querySelectorAll("article");
  articles.forEach((article) => {
    const description = article.querySelector(".description") as HTMLElement;
    const title = article.querySelector(".title") as HTMLElement;

    if (description && title) {
      const updateTitlePosition = () => {
        const descriptionHeight = description.offsetHeight;
        title.style.bottom = `${descriptionHeight - 1}px`;
      };

      // 初始设置
      updateTitlePosition();

      // 监听窗口大小变化
      window.addEventListener("resize", updateTitlePosition);
    }
  });

  const randomImages = document.querySelectorAll<HTMLImageElement>(
    "img[data-random-seed]",
  );
  const resizeObservers: ResizeObserver[] = [];

  const buildSrc = (
    base: string,
    seed: string,
    width: number,
    height: number,
    scale = 1,
  ) => {
    const w = Math.max(1, Math.round(width * scale));
    const h = Math.max(1, Math.round(height * scale));
    return `${base}/seed/${seed}/${w}/${h}`;
  };

  const applyAdaptiveSrc = (img: HTMLImageElement, rect: DOMRectReadOnly) => {
    const seed = img.dataset.randomSeed;
    const base = img.dataset.randomBase || "https://picsum.photos";
    if (!seed || rect.width === 0 || rect.height === 0) return;

    const primary = buildSrc(base, seed, rect.width, rect.height, 1);
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    const retina = buildSrc(base, seed, rect.width, rect.height, dpr);
    img.src = primary;
    img.srcset = `${primary} 1x, ${retina} 2x`;
  };

  randomImages.forEach((img) => {
    const container = img.closest<HTMLElement>("[data-random-container]");
    if (!container) return;

    applyAdaptiveSrc(img, container.getBoundingClientRect());

    const observer = new ResizeObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.target === container) {
          applyAdaptiveSrc(img, entry.contentRect);
        }
      });
    });

    observer.observe(container);
    resizeObservers.push(observer);
  });

  window.addEventListener("beforeunload", () => {
    resizeObservers.forEach((observer) => observer.disconnect());
  });
</script>
