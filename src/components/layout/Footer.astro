---
import { SITE_TITLE } from "@/consts";

const currentYear = new Date().getFullYear();
const startYear = 2024;
const yearsRunning = currentYear - startYear;
---

<footer class="footer-container w-screen relative overflow-hidden">
  <!-- 深色区块。亮色模式下与纸面形成对比，是设计意图；暗色模式下页面本身已经
       是深底，再用 #2a2926 只有 1.28:1，footer 会整块糊进背景 —— 所以暗色改走
       surface-sunken（比页面更暗）并补一道上边线，靠层次而非明度差建立分界。 -->
  <div class="footer-bg absolute inset-0"></div>
  
  <!-- 主内容 -->
  <div class="footer-content relative z-10 max-w-6xl mx-auto px-8 py-16">
    <!-- 顶部分隔线 -->
    <div class="footer-divider w-full h-px mb-12"></div>
    
    <!-- 网格布局 -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
      <!-- 左侧：Logo 和简介 -->
      <div class="footer-brand space-y-4">
        <h3 class="text-4xl font-bold">
          {SITE_TITLE}
        </h3>
        <p class="text-lg opacity-80 leading-relaxed">
          A newbie Frontend developer who loves designing and coding.
        </p>
      </div>
      
      <!-- 中间：运行状态 -->
      <div class="footer-links space-y-4">
        <h4 class="text-xl font-semibold mb-6">
          Status
        </h4>
        <div class="flex flex-col space-y-3">
          <p class="text-lg font-mono">
            🟢 Stable for {yearsRunning > 0 ? `${yearsRunning} ${yearsRunning === 1 ? 'year' : 'years'}` : 'less than a year'}
          </p>
          <a href="/rss.xml" class="footer-link text-lg hover:translate-x-2 transition-transform duration-300">
            RSS Feed
          </a>
        </div>
      </div>
      
      <!-- 右侧：GitHub 链接 -->
      <div class="footer-social space-y-4">
        <h4 class="text-xl font-semibold mb-6">
          Source Code
        </h4>
        <a
          href="https://github.com/ifeichuan/Blog"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 text-lg font-mono hover:opacity-100 transition-opacity duration-200 group"
        >
          <div class="footer-avatar w-12 h-12 rounded-full flex items-center justify-center transition-colors duration-300">
            <svg viewBox="0 0 16 16" class="w-6 h-6" fill="currentColor">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
            </svg>
          </div>
          <span>ifeichuan/Blog</span>
        </a>
      </div>
    </div>
    
    <!-- 底部版权信息 -->
    <div class="footer-bottom pt-8">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-sm font-mono opacity-70">
          © {currentYear} {SITE_TITLE}. All rights reserved.
        </p>
        <p class="text-sm font-mono opacity-70">
          Built with <span class="inline-block">♥</span> using Astro & GSAP
        </p>
      </div>
    </div>
  </div>
  
  <!-- 底部装饰线 -->
  <div class="footer-baseline absolute bottom-0 left-0 w-full h-px"></div>
</footer>

<style>
  /* footer 是「反相区块」：亮色下深底浅字，与纸面对比；暗色下页面已是深底，
   * 于是改用 surface-sunken 往下沉一层，靠层次而非明度反转维持分界。
   * 三个变量集中在这里，正文里只写语义 class。 */
  .footer-container {
    --footer-bg: #2a2926;
    --footer-ink: oklch(97% 0.004 98);
    --footer-line: color-mix(in oklab, var(--footer-ink) 22%, transparent);

    position: relative;
    min-height: 400px;
    color: var(--footer-ink);
  }

  :global([data-fc-theme="dark"]) .footer-container {
    --footer-bg: var(--fc-surface-sunken);
    --footer-ink: var(--fc-ink);
    --footer-line: var(--fc-border-strong);
  }

  .footer-bg {
    background-color: var(--footer-bg);
    transition: background-color var(--fc-motion-hover);
  }

  /* 上下两道装饰线原为 white/40 与 white/60，暗色下会亮得刺眼 */
  .footer-divider,
  .footer-baseline {
    background: linear-gradient(
      to right,
      transparent,
      var(--footer-line),
      transparent
    );
  }

  .footer-bottom {
    border-top: 1px solid var(--footer-line);
  }

  /* GitHub 图标底托，原为 #3d3b38 / hover #4a4845 —— 换成从 footer 底色推导，
   * 这样暗色下也自动跟着变，不必维护第二组色号 */
  .footer-avatar {
    background: color-mix(in oklab, var(--footer-ink) 12%, var(--footer-bg));
  }

  .group:hover .footer-avatar {
    background: color-mix(in oklab, var(--footer-ink) 20%, var(--footer-bg));
  }

  .footer-link {
    position: relative;
    display: inline-block;
  }
  
  .footer-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: currentColor;
    transition: width 0.3s ease;
  }
  
  .footer-link:hover::after {
    width: 100%;
  }
  
  /* 响应式调整 */
  @media (max-width: 768px) {
    .footer-content {
      padding: 3rem 1.5rem;
    }
    
    .grid {
      gap: 2rem;
    }
  }
</style>
