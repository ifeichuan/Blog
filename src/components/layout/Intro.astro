<script>
  import gsap from "gsap";
  import introSoundUrl from "@/assets/sound.wav?url";
  import { emitter } from "@/lib/utils";
  const intro = document.querySelector<HTMLElement>("[data-home-intro]");

  if (intro) {
    const storageKey = "home-intro-seen";
    const loadProcessElement = intro.querySelector<HTMLElement>("#load-progress");
    const loadStatusElement = intro.querySelector<HTMLElement>("#load-status");
    const loadBars = Array.from(intro.querySelectorAll<HTMLElement>(".load-bar-block"));
    const leadBarCount = Math.ceil(loadBars.length * 0.85);
    const leadBars = loadBars.slice(0, leadBarCount);
    const completionBars = loadBars.slice(leadBarCount);
    const purple = intro.querySelector<HTMLElement>(".purple");
    const loadBottom = intro.querySelector<HTMLElement>(".load-bottom");
    const cardTop = intro.querySelector<HTMLElement>(".card-top");
    const loadBackground = intro.querySelector<HTMLElement>(".load-bg");
    const modal = intro.querySelector<HTMLElement>(".load-modal");
    const homepageSlot = document.querySelector<HTMLElement>("#homepage-root");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let seen = false;

    try {
      seen = sessionStorage.getItem(storageKey) === "true";
    } catch {}

    document.documentElement.dataset.introActive = "true";
    window.dispatchEvent(new Event("Intro:start"));

    const finish = () => {
      if (homepageSlot) {
        homepageSlot.style.clipPath = "none";
        homepageSlot.style.height = "auto";
      }
      intro.remove();
      delete document.documentElement.dataset.introActive;
      document.documentElement.dataset.introEnded = "true";
      emitter.emit("Intro:end");
      window.dispatchEvent(new Event("Intro:end"));
    };

    const beginExit = () => {
      window.dispatchEvent(new Event("Intro:exit"));
    };

    if (seen) {
      beginExit();
      finish();
    } else if (
      loadProcessElement &&
      loadStatusElement &&
      purple &&
      loadBottom &&
      cardTop &&
      loadBackground &&
      modal
    ) {
      const initText = gsap.to(loadStatusElement, {
        opacity: 0.1,
        duration: 0.5,
        yoyo: true,
        repeat: -1,
      });

      const introAudio = new Audio(introSoundUrl);
      introAudio.preload = "auto";
      introAudio.volume = 0.45;
      introAudio.loop = false;

      const segmentEnd = 0.3;
      let shouldPlay = false;
      let loopRaf = 0;

      const rewindAudio = () => {
        try {
          introAudio.currentTime = 0;
        } catch {}
      };

      const loopSegment = () => {
        if (!shouldPlay) return;
        if (introAudio.currentTime >= segmentEnd) {
          rewindAudio();
          if (introAudio.paused) introAudio.play().catch(() => {});
        }
        loopRaf = requestAnimationFrame(loopSegment);
      };

      const tryResumeAudio = () => {
        if (shouldPlay) introAudio.play().catch(() => {});
      };

      const startIntroSound = () => {
        shouldPlay = true;
        rewindAudio();
        introAudio.play().catch(() => {});
        if (loopRaf) cancelAnimationFrame(loopRaf);
        loopRaf = requestAnimationFrame(loopSegment);
        document.addEventListener("pointerdown", tryResumeAudio, { once: true });
        document.addEventListener("keydown", tryResumeAudio, { once: true });
      };

      const stopIntroSound = () => {
        shouldPlay = false;
        if (loopRaf) cancelAnimationFrame(loopRaf);
        loopRaf = 0;
        introAudio.pause();
        rewindAudio();
        document.removeEventListener("pointerdown", tryResumeAudio);
        document.removeEventListener("keydown", tryResumeAudio);
      };

      const setProgress = (value: number) => {
        const progress = Math.min(100, Math.max(0, Math.floor(value)));
        loadProcessElement.textContent = `${progress}%`;
        intro.setAttribute("aria-valuenow", String(progress));
      };

      const homepageOutcome = new Promise<boolean>((resolve) => {
        if (document.documentElement.dataset.homepageReady === "true") {
          resolve(true);
          return;
        }
        window.addEventListener("homepage:ready", () => resolve(true), { once: true });
        window.addEventListener("homepage:error", () => resolve(false), { once: true });
      });

      const leadProgress = { value: 0 };
      const leadDone = new Promise<void>((resolve) => {
        const lead = gsap.timeline({ defaults: { ease: "power3.inOut" }, onComplete: resolve });
        lead
          .to(leadProgress, {
            value: 85,
            duration: reducedMotion ? 0 : 2.5,
            ease: `steps(${Math.max(1, Math.floor(Math.random() * 100))})`,
            onStart: startIntroSound,
            onUpdate: () => {
              setProgress(leadProgress.value);
              if (shouldPlay && introAudio.paused) introAudio.play().catch(() => {});
            },
          })
          .to(leadBars, { opacity: 1, stagger: reducedMotion ? 0 : 0.1, duration: reducedMotion ? 0 : 0.8 }, "<");
      });

      gsap.set([loadBackground, modal], { opacity: 1 });

      Promise.all([leadDone, homepageOutcome]).then(([, remember]) => {
        loadStatusElement.textContent = "ready";
        initText.seek(0);
        initText.kill();

        if (reducedMotion) {
          setProgress(100);
          stopIntroSound();
          beginExit();
          finish();
          return;
        }

        const completionProgress = { value: 85 };
        const ease = "cubic-bezier(0.27,0.78,0.36,0.97)";
        gsap.timeline({ defaults: { ease: "power3.inOut" } })
          .to(completionProgress, {
            value: 100,
            duration: 0.6,
            ease: "steps(15)",
            onUpdate: () => setProgress(completionProgress.value),
            onComplete: stopIntroSound,
          })
          .to(completionBars, {
            opacity: 1,
            stagger: 0.08,
            duration: 0.25,
          }, "<")
          .to(purple, {
            x: () => intro.querySelector<HTMLElement>(".card-grid__inner")?.clientWidth || 0,
            duration: 1,
          }, ">+0.2")
          .to(loadBottom, {
            scaleY: 0,
            transformOrigin: "top",
            duration: 1,
          }, "<+0.5")
          .to(loadBars, {
            backgroundColor: "var(--color-blue-900)",
            stagger: 0.02,
            duration: 0.5,
          }, "<-0.1")
          .to(cardTop, {
            scaleY: 0,
            scaleX: 0,
            transformOrigin: "center",
            duration: 0.5,
          }, ">-0.2")
          .to(homepageSlot, {
            "--clip-top": "0%",
            "--clip-right": "0%",
            "--clip-bottom": "0%",
            "--clip-left": "0%",
            duration: 1,
            ease,
            onStart: beginExit,
            onComplete: () => {
              if (homepageSlot) {
                homepageSlot.style.clipPath = "none";
                homepageSlot.style.height = "auto";
              }
            },
          }, ">+0.2")
          .to(modal, {
            width: () => window.innerWidth + 150,
            height: () => window.innerHeight + 150,
            ease,
            duration: 1,
            onComplete: () => {
              if (remember) {
                try {
                  sessionStorage.setItem(storageKey, "true");
                } catch {}
              }
              finish();
            },
          }, "<+0.05");
      });
    }
  }
</script>
