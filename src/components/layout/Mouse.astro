<div id="point1" class=""></div>
<div id="point2" class=""></div>
<style>
  /* 两个光点都是「浅色 + multiply」：在纸面上是柔和的着色，在暗底上 multiply
   * 只做减法，浅蓝乘深底趋近黑 —— 光标变成一个跟着鼠标走的黑洞。
   * 暗色统一换 screen（加法），才是同一种「柔和着色」的观感。
   *
   * 悬停/静止两态原先由 JS 写内联 mixBlendMode，内联样式优先级最高，CSS 里的
   * 暗色分支会被它盖掉。改成 JS 只切 class，混合模式的决定权留在这里。 */
  #point1,
  #point2 {
    position: fixed;
    top: 0;
    left: 0;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    z-index: 1000000;
    mix-blend-mode: multiply;
    pointer-events: none;
    background: var(--color-blue-400);
  }
  #point2 {
    width: 3rem;
    height: 3rem;
    background: var(--color-sky-200);
    transition: all 0.2s ease-out;
    backdrop-filter: blur(0.5px) brightness(1.1) saturate(1.5);
    z-index: 999999;
  }

  /* soft-light 对浅色源是「提亮」，两套 palette 下都成立，不必分支 */
  #point2.is-hover {
    mix-blend-mode: soft-light;
  }
  #point2.is-idle {
    mix-blend-mode: overlay;
  }

  /* overlay 在暗底上等价于 multiply，同样会把光点吃掉，所以静止态也要覆盖 */
  :global([data-fc-theme="dark"]) #point1,
  :global([data-fc-theme="dark"]) #point2,
  :global([data-fc-theme="dark"]) #point2.is-idle {
    mix-blend-mode: screen;
  }
</style>
<script>
  window.addEventListener("load", () => {
    const body = document.body;
    const g1: HTMLDivElement =
      document.querySelector("#point1") || new HTMLDivElement();
    const g2: HTMLDivElement =
      document.querySelector("#point2") || new HTMLDivElement();
    let g1Width = 0;
    let g2Width = 0;
    let isHovering = false;
    g1Width = g1.offsetWidth / 2;
    g2Width = g2.offsetWidth / 2;
    const setPosition = (x: number, y: number) => {
      window.requestAnimationFrame(() => {
        g1.style.transform = `translate(${x - g1Width}px, ${y - g1Width}px)`;
      });
      if (!isHovering) {
        g2.style.transform = `translate(${x - g2Width}px, ${y - g2Width}px)`;
      }
    };
    const onMouseMove = (e: MouseEvent) => {
      window.requestAnimationFrame(() => {
        setPosition(e.clientX, e.clientY);
      });
    };
    const onMouseOver = (e: MouseEvent) => {
      const target = e.target as Element;
      if (target.classList.contains("g-animation")) {
        isHovering = true;
        const rect = target.getBoundingClientRect();
        const style = window.getComputedStyle(target);
        g2.style.width = `${rect.width + 20}px`;
        g2.style.height = `${rect.height + 20}px`;
        // 只切 class，混合模式交给 CSS —— 内联样式会盖掉暗色分支
        g2.classList.add("is-hover");
        g2.classList.remove("is-idle");
        const borderRadius = style.borderRadius.slice(
          0,
          style.borderRadius.lastIndexOf("p"),
        );
        // console.log(border);
        const border = "inset 0 0 5px rgba(0,0,0,0.2)";
        g2.style.boxShadow = border;
        g2.style.borderRadius =
          Math.max(parseInt(borderRadius) / 16, 1) + "rem";
        g2.style.transform = `translate(${rect.left - 10}px, ${rect.top - 10}px)`;
      }
    };
    const onMouseOut = (e: MouseEvent) => {
      const target = e.target as Element;
      if (target.classList.contains("g-animation")) {
        isHovering = false;

        g2.style.width = `3rem`;
        g2.style.height = `3rem`;
        g2.style.borderRadius = `50%`;
        g2.classList.remove("is-hover");
        g2.classList.add("is-idle");
      }
    };
    const onMouseWheel = (e: WheelEvent) => {
      if (isHovering) {
        onMouseOut(e);
        onMouseMove(e);
      }
    };
    window.addEventListener("mousemove", onMouseMove, {
      passive: true,
    });
    window.addEventListener("mouseover", onMouseOver, { passive: true });
    window.addEventListener("mouseout", onMouseOut, { passive: true });
    window.addEventListener("wheel", onMouseWheel, { passive: true });

    const observer = new MutationObserver(() => {
      const allClickElement = document.querySelectorAll(
        "a,button,pre,code,img",
      );
      // console.log(allClickElement)
      allClickElement.forEach((e) => {
        if (!e.classList.contains("g-not") && !e.closest(".g-not"))
          e.classList.toggle("g-animation", true);
      });
    });
    observer.observe(document.documentElement, {
      childList: true,
      subtree: true,
    });
  });
</script>
