---
import { SITE_TITLE } from "../consts";

const currentYear = new Date().getFullYear();
const startYear = 2024;
const yearsRunning = currentYear - startYear;
---

<footer class="footer-container w-screen relative overflow-hidden text-white">
  <!-- 半透明背景 -->
  <div class="footer-bg absolute inset-0 backdrop-blur-2xl bg-white/10"></div>
  
  <!-- 主内容 -->
  <div class="footer-content relative z-10 max-w-6xl mx-auto px-8 py-16">
    <!-- 顶部分隔线 -->
    <div class="footer-divider w-full h-px bg-gradient-to-r from-transparent via-white/40 to-transparent mb-12"></div>
    
    <!-- 网格布局 -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
      <!-- 左侧：Logo 和简介 -->
      <div class="footer-brand space-y-4">
        <h3 class="text-4xl font-serif font-bold mix-blend-overlay">
          {SITE_TITLE}
        </h3>
        <p class="text-lg opacity-80 mix-blend-overlay font-serif leading-relaxed">
          A newbie Frontend developer who loves designing and coding.
        </p>
      </div>
      
      <!-- 中间：运行状态 -->
      <div class="footer-links space-y-4">
        <h4 class="text-xl font-serif font-semibold mix-blend-overlay mb-6">
          Status
        </h4>
        <div class="flex flex-col space-y-3">
          <p class="text-lg font-mono mix-blend-overlay">
            🟢 Stable for {yearsRunning > 0 ? `${yearsRunning} ${yearsRunning === 1 ? 'year' : 'years'}` : 'less than a year'}
          </p>
          <a href="/rss.xml" class="footer-link text-lg font-serif mix-blend-overlay hover:translate-x-2 transition-transform duration-300">
            RSS Feed
          </a>
        </div>
      </div>
      
      <!-- 右侧：GitHub 链接 -->
      <div class="footer-social space-y-4">
        <h4 class="text-xl font-serif font-semibold mix-blend-overlay mb-6">
          Source Code
        </h4>
        <a
          href="https://github.com/ifeichuan/Blog"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 text-lg font-mono mix-blend-overlay hover:opacity-100 transition-opacity duration-200 group"
        >
          <div class="w-12 h-12 rounded-full backdrop-blur-xl bg-white/20 flex items-center justify-center group-hover:bg-white/40 transition-colors duration-300">
            <svg viewBox="0 0 16 16" class="w-6 h-6" fill="currentColor">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
            </svg>
          </div>
          <span>ifeichuan/Blog</span>
        </a>
      </div>
    </div>
    
    <!-- 底部版权信息 -->
    <div class="footer-bottom pt-8 border-t border-white/20">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-sm font-mono mix-blend-overlay opacity-70">
          © {currentYear} {SITE_TITLE}. All rights reserved.
        </p>
        <p class="text-sm font-mono mix-blend-overlay opacity-70">
          Built with <span class="inline-block">♥</span> using Astro & GSAP
        </p>
      </div>
    </div>
  </div>
  
  <!-- 底部装饰线 -->
  <div class="absolute bottom-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-white/60 to-transparent"></div>
</footer>

<style>
  .footer-container {
    position: relative;
    min-height: 400px;
  }
  
  .footer-link {
    position: relative;
    display: inline-block;
  }
  
  .footer-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: currentColor;
    transition: width 0.3s ease;
  }
  
  .footer-link:hover::after {
    width: 100%;
  }
  
  /* 响应式调整 */
  @media (max-width: 768px) {
    .footer-content {
      padding: 3rem 1.5rem;
    }
    
    .grid {
      gap: 2rem;
    }
  }
</style>
