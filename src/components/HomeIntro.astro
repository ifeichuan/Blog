<div class="home-intro" data-home-intro role="progressbar" aria-label="Loading homepage" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
  <div class="home-intro__track">
    <div class="home-intro__progress" data-home-intro-progress></div>
  </div>
</div>

<script>
  const intro = document.querySelector<HTMLElement>("[data-home-intro]");
  const progress = document.querySelector<HTMLElement>("[data-home-intro-progress]");

  if (intro && progress) {
    const storageKey = "home-intro-seen";
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let seen = false;

    try {
      seen = sessionStorage.getItem(storageKey) === "true";
    } catch {}

    if (seen) intro.dataset.seen = "true";

    document.documentElement.dataset.introActive = "true";
    window.dispatchEvent(new Event("Intro:start"));

    let completing = false;

    const setProgress = (nextValue: number) => {
      const value = Math.min(100, Math.max(0, nextValue));
      progress.style.transform = `scaleX(${value / 100})`;
      intro.setAttribute("aria-valuenow", String(value));
    };

    const removeIntro = () => {
      intro.classList.add("is-exiting");
      const exitDuration = reducedMotion || seen ? 120 : 420;

      window.setTimeout(() => {
        intro.remove();
        delete document.documentElement.dataset.introActive;
        window.dispatchEvent(new Event("Intro:end"));
      }, exitDuration);
    };

    const complete = (remember: boolean) => {
      if (completing) return;
      completing = true;

      if (seen || reducedMotion) {
        setProgress(100);
        removeIntro();
        return;
      }

      const duration = 600;
      progress.style.transitionDuration = `${duration}ms`;
      progress.style.transitionTimingFunction = "cubic-bezier(0.22, 1, 0.36, 1)";
      setProgress(100);

      window.setTimeout(() => {
        if (remember) {
          try {
            sessionStorage.setItem(storageKey, "true");
          } catch {}
        }

        window.setTimeout(removeIntro, 140);
      }, duration);
    };

    window.addEventListener("homepage:ready", () => complete(true), { once: true });
    window.addEventListener("homepage:error", () => complete(false), { once: true });

    if (document.documentElement.dataset.homepageReady === "true") {
      complete(true);
    } else if (!seen && !reducedMotion) {
      progress.getBoundingClientRect();
      setProgress(85);
    }
  }
</script>

<style>
  .home-intro {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    background: #f5f4ed;
    opacity: 1;
    transition: opacity 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .home-intro[data-seen="true"] {
    transition-duration: 120ms;
  }

  .home-intro.is-exiting {
    opacity: 0;
    pointer-events: none;
  }

  .home-intro__track {
    width: min(18rem, calc(100vw - 3rem));
    height: 2px;
    overflow: hidden;
    background: rgba(20, 20, 19, 0.16);
  }

  .home-intro__progress {
    width: 100%;
    height: 100%;
    background: #141413;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 2400ms cubic-bezier(0.18, 0.72, 0.25, 1);
    will-change: transform;
  }

  .home-intro[data-seen="true"] .home-intro__track {
    visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-intro {
      transition-duration: 100ms;
    }
  }
</style>
