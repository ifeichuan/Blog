---
import BaseHead from "../components/BaseHead.astro";
import { isProd, SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import path from "node:path";
import Mouse from "../components/Mouse.astro";
import Nav from "@/components/Nav.astro";
import type { Image } from "astro:assets";

import Noise from "@/components/Noise";
import mesh from "@/assets/mesh.png";
import Intro from "@/components/Intro.astro";
if (!isProd) {
  import("../styles/dev.css");
}
export type Props = {
  title?: string;
  description?: string;
  banner?: string;
  showIntro?: boolean;
};

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  banner = "https://s2.loli.net/2025/10/29/EucqwWi18kdsRBp.png",
  showIntro = false,
}: Props = Astro.props;
---

<!doctype html>
<html>
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <Intro class:list={[showIntro ? "opacity-0" : ""]} />

    <Mouse />
    <Nav />
    <div class="smooth-wrapper slot overflow-scroll">
      <main
        class=`background w-screen  smooth-content bg-fixed bg-no-repeat bg-cover `
        style={`background-image: url('${banner}');`}
      >
        <slot />
      </main>
    </div>
    <!-- <Footer /> -->
    <script></script>
    <style>
      .slot {
        clip-path: inset(
          var(--clip-top) var(--clip-right) var(--clip-bottom) var(--clip-left)
        );
        height: var(--clip-height);
        width: var(--clip-width);
      }
    </style>
  </body>
</html>
