---
import BaseHead from "../components/BaseHead.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import path from "node:path";
import Mouse from "../components/Mouse.astro";
import Nav from "@/components/Nav.astro";
import type { Image } from "astro:assets";

import Noise from "@/components/Noise";
import mesh from "@/assets/mesh.png";
import Intro from "@/components/Intro.astro";
export type Props = {
  title?: string;
  description?: string;
  banner?: string;
  showIntro?: boolean;
};
const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  banner = "https://s2.loli.net/2025/10/29/EucqwWi18kdsRBp.png",
  showIntro = false,
}: Props = Astro.props;
---

<!doctype html>
<html>
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <Intro class:list={[showIntro ? "opacity-0" : ""]} />

    <Mouse />
    <Nav />
    <main
      class="background w-screen bg-fixed bg-no-repeat bg-cover bg-scroll slot"
      style={`background-image: url('${banner}');`}
    >
      <Noise client:visible />
      <slot />
    </main>
    <!-- <Footer /> -->
  </body>
</html>
