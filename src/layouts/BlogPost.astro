---
import { type CollectionEntry, getCollection, render } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import Base from "./Base.astro";
import TOC from "@/components/TOC.astro";
type Props = CollectionEntry<"blog">["data"];

const { title, description, banner, dateCreated, dateModified, isPub } =
  Astro.props.data;

const { headings } = await render(Astro.props);
---

<Base banner={banner}>
  <div
    class="w-screen h-full flex flex-col items-center backdrop-blur-2xl bg-white/60 dark:bg-black/60 backdrop-grayscale"
  >
    <div class="h-80 bg-sky-400 w-screen relative">
      <img
        src={banner}
        alt=""
        class="object-cover w-full h-full absolute g-not"
      />
      <div class="absolute mx-auto left-0 right-0 bottom-16">
        <h1
          class="text-5xl font-serif font-bold mb-4 mix-blend-overlay text-center [text-shadow:0_4px_5px_rgba(0,0,0,1)] shadow-2xl text-white"
        >
          {title}
        </h1>
      </div>
      <div class="text-sm">
        <span>Published on: <FormattedDate date={dateCreated} /></span>
        {
          dateModified && (
            <span class="ml-4">
              Last modified: <FormattedDate date={dateModified} />
            </span>
          )
        }
      </div>
    </div>
    <div class="">
      <slot />
    </div>
  </div>
</Base>
<script>
  window.addEventListener("load", () => {
    window.dispatchEvent(new Event("Intro:end"));
  });
</script>
