---
import { type CollectionEntry, getCollection, render } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import Base from "./Base.astro";
import TOC from "@/components/TOC.astro";
type Props = CollectionEntry<"blog">["data"];

const { title, description, banner, dateCreated, dateModified, isPub } =
  Astro.props.data;
const { headings } = await render(Astro.props);
---

<Base banner={banner}>
  <TOC headings={headings} />
  <div
    class="w-screen h-full flex flex-col items-center backdrop-blur-2xl bg-white/60 dark:bg-black/60 backdrop-grayscale"
  >
    <div class="h-80 bg-sky-400 w-screen relative">
      <img src={banner} alt="" class="object-cover w-full h-full absolute" />
      <h1 class="text-4xl font-bold mb-4 mix-blend-overlay">
        {title}
      </h1>
      <div class="text-sm">
        <span>Published on: <FormattedDate date={dateCreated} /></span>
        {
          dateModified && (
            <span class="ml-4">
              Last modified: <FormattedDate date={dateModified} />
            </span>
          )
        }
      </div>
    </div>
    <div class="flex justify-center w-full relative">
      <slot />
    </div>
  </div>
</Base>
<script>
  window.addEventListener("load", () => {
    window.dispatchEvent(new Event("Intro:end"));
  });
</script>
