{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "main": "./dist/_worker.js/index.js",
  // 更新为今天的日期
  "compatibility_date": "2025-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "vars":{
    "UMAMI_API_CLIENT_ENDPOINT": "https://api.umami.is/v1",
    "UMAMI_WEBSITE_ID": "e68649b2-93c5-4ee5-abd9-78cca185ebed"
  }
}
